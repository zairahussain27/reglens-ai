# Database: SQLite by default. For Supabase/Postgres use the pooler URL.
DATABASE_URL=sqlite:///./reglens.db
JWT_SECRET=replace-with-a-long-random-secret
DEMO_MODE=false
# Google sign-in (Google Cloud Console > Credentials > OAuth client ID > Web application)
GOOGLE_CLIENT_ID=635044730253-htnm5ru6tadplku0ncd95eo4uqotla65.apps.googleusercontent.com
# Optional grounded answer generation. Anthropic is preferred when both keys are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Alternative provider (https://console.groq.com). Without either key, Ask returns cited extractive answers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Embeddings: fastembed (real model) or hash (no download, for tests)
EMBEDDINGS=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIN_SCORE=0.2

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=reglens_chunks_v2
QDRANT_TIMEOUT_SECONDS=60

# Optional email for reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
UPLOAD_DIR=./uploads

# Production: set this to the exact Vercel URL, for example:
# CORS_ORIGINS=https://reglens-ai.vercel.app
